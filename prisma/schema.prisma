generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model categorias {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique @db.VarChar(45)
  created_at DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at DateTime?   @default(now()) @db.Timestamptz(6)
  productos  productos[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model empleados {
  id         Int               @id @default(autoincrement())
  nombre     String            @db.VarChar(45)
  apellido_p String            @db.VarChar(45)
  apellido_m String?           @db.VarChar(45)
  telefono   String?           @db.VarChar(15)
  rol        rol_empleado_enum @default(Employee)
  activo     Boolean?          @default(true)
  created_at DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at DateTime?         @default(now()) @db.Timestamptz(6)
  email      String?           @unique @db.VarChar(100)
  password   String?           @db.VarChar(255)
  ventas     ventas[]

  @@index([activo], map: "idx_empleados_activo")
  @@index([rol], map: "idx_empleados_rol")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model marcas {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique @db.VarChar(45)
  created_at DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at DateTime?   @default(now()) @db.Timestamptz(6)
  productos  productos[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model productos {
  id           Int           @id @default(autoincrement())
  nombre       String        @db.VarChar(45)
  color        String?       @db.VarChar(45)
  categoria_id Int
  marca_id     Int
  activo       Boolean?      @default(true)
  created_at   DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?     @default(now()) @db.Timestamptz(6)
  inventarios  inventarios[]
  categorias   categorias    @relation(fields: [categoria_id], references: [id])
  marcas       marcas        @relation(fields: [marca_id], references: [id])
  imagenes_productos     imagenes_productos[]

  @@unique([nombre, color, categoria_id, marca_id])
  @@index([activo], map: "idx_productos_activo")
  @@index([categoria_id], map: "idx_productos_categoria")
  @@index([categoria_id, marca_id], map: "idx_productos_categoria_marca")
  @@index([marca_id], map: "idx_productos_marca")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model ventas {
  id            Int             @id @default(autoincrement())
  fecha         DateTime?       @default(now()) @db.Timestamptz(6)
  tipo_venta    tipo_venta_enum @default(Presencial)
  tipo_pago     tipo_pago_enum
  cliente_id    Int?
  empleado_id   Int
  subtotal      Decimal         @default(0) @db.Decimal(10, 2)
  descuento     Decimal         @default(0) @db.Decimal(10, 2)
  total         Decimal         @db.Decimal(10, 2)
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?       @default(now()) @db.Timestamptz(6)
  detalleventas detalleventas[]
  clientes      clientes?       @relation(fields: [cliente_id], references: [id])
  empleados     empleados       @relation(fields: [empleado_id], references: [id])

  @@index([cliente_id], map: "idx_ventas_cliente")
  @@index([empleado_id], map: "idx_ventas_empleado")
  @@index([fecha], map: "idx_ventas_fecha")
  @@index([fecha, tipo_venta], map: "idx_ventas_fecha_tipo")
  @@index([tipo_venta], map: "idx_ventas_tipo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model clientes {
  id               Int         @id @default(autoincrement())
  nombres          String      @db.VarChar(45)
  apellido_p       String      @db.VarChar(45)
  apellido_m       String?     @db.VarChar(45)
  telefono         String?     @db.VarChar(15)
  email            String?     @unique @db.VarChar(100)
  fecha_nacimiento DateTime?   @db.Date
  password         String      @db.VarChar(255)
  domicilio_id     Int?
  activo           Boolean?    @default(true)
  created_at       DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?   @default(now()) @db.Timestamptz(6)
  domicilios       domicilios? @relation(fields: [domicilio_id], references: [id])
  ventas           ventas[]

  @@index([activo], map: "idx_clientes_activo")
  @@index([email], map: "idx_clientes_email")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model detalleventas {
  id            Int         @id @default(autoincrement())
  venta_id      Int
  inventario_id Int
  cantidad      Int
  total         Decimal     @db.Decimal(10, 2)
  created_at    DateTime?   @default(now()) @db.Timestamptz(6)
  inventarios   inventarios @relation(fields: [inventario_id], references: [id])
  ventas        ventas      @relation(fields: [venta_id], references: [id], onDelete: Cascade)

  @@unique([venta_id, inventario_id])
  @@index([inventario_id], map: "idx_detalleventas_inventario")
  @@index([venta_id], map: "idx_detalleventas_venta")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model domicilios {
  id         Int        @id @default(autoincrement())
  calle      String     @db.VarChar(45)
  colonia    String     @db.VarChar(45)
  numero     String     @db.VarChar(45)
  cp         String     @db.VarChar(10)
  ciudad     String     @db.VarChar(45)
  estado     String     @db.VarChar(45)
  referencia String?    @db.VarChar(45)
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at DateTime?  @default(now()) @db.Timestamptz(6)
  clientes   clientes[]
}

model imagenes_productos {
  id           Int        @id @default(autoincrement())
  producto_id  Int
  url          String     @db.VarChar(500)
  es_principal Boolean?   @default(false)
  created_at   DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?  @default(now()) @db.Timestamptz(6)

  productos     productos       @relation(fields: [producto_id], references: [id], onDelete: Cascade)

  @@index([producto_id], map: "idx_imagenes_productos_producto")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model inventarios {
  id            Int             @id @default(autoincrement())
  producto_id   Int
  talla         String          @db.VarChar(10)
  cantidad      Int             @default(0)
  precio_venta  Decimal         @db.Decimal(10, 2)
  precio_compra Decimal         @db.Decimal(10, 2)
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?       @default(now()) @db.Timestamptz(6)
  detalleventas detalleventas[]
  productos     productos       @relation(fields: [producto_id], references: [id], onDelete: Cascade)

  @@unique([producto_id, talla])
  @@index([cantidad], map: "idx_inventarios_cantidad")
  @@index([producto_id], map: "idx_inventarios_producto")
  @@index([producto_id, talla], map: "idx_inventarios_producto_talla")
}

enum rol_empleado_enum {
  Admin
  Employee
}

enum tipo_pago_enum {
  Efectivo
  Tarjeta
  Transferencia
}

enum tipo_venta_enum {
  Presencial
  Online
}
